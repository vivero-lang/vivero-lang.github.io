---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { copy } from '../content/copy';
---
<Base title={`Press & QR | ${copy.name}`}>
  <section class="wrap press">
    <h1>Press &amp; QR</h1>
    <div class="grid">
      <figure><img src="/brand/vivero-qr.svg" alt="QR code linking to vivero-lang.github.io" width="240" height="240" /><figcaption>QR code: <a href="/brand/vivero-qr.svg">SVG</a> · <a href="/brand/vivero-qr.png">PNG</a></figcaption></figure>
      <figure><Logo size={200} /><figcaption>Logo: <a href="/brand/vivero-logo.svg">SVG</a></figcaption></figure>
    </div>
  </section>
</Base>
<style>
  .press { padding-block: 56px 0; }
  .press h1 { font-size: var(--step-3); }
  .grid { display: flex; flex-wrap: wrap; gap: 40px; }
  figure { margin: 0; display: grid; gap: 10px; justify-items: start; }
  figure img { background: #F5F2EA; padding: 12px; border-radius: 6px; }
  figcaption { color: var(--muted); font-size: .92rem; }
</style>
