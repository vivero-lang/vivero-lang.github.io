---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import GlassPane from '../components/GlassPane.astro';
import Mullions from '../components/Mullions.astro';
import T from '../components/T.astro';
import { copy, links, team } from '../content/copy';
---
<Base>
  <section class="hero">
    <Mullions />
    <div class="wrap hero-inner">
      <Logo size={88} label="Vivero logo" />
      <h1>{copy.name}</h1>
      <p class="one-liner">{copy.oneLiner}</p>
      <p class="framing">{copy.framing}</p>
      <div class="ctas">
        <a class="btn btn-primary" href={links.mailto}>{copy.contact.button}</a>
        <a class="btn btn-glass" href={links.translator} target="_blank" rel="noopener">{copy.osage.translatorLabel} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section id="how" class="wrap block">
    <h2><T text={copy.howItGrows.heading} /></h2>
    <div class="panes">
      {copy.howItGrows.panes.map((p) => (
        <GlassPane title={p.title}><p><T text={p.body} /></p></GlassPane>
      ))}
    </div>
  </section>

  <section id="osage" class="wrap block osage">
    <div class="word">
      <span class="script" lang="osa"><T text={copy.osage.word.script} /></span>
      <span class="latin"><T text={copy.osage.word.latin} /></span>
      <span class="gloss"><T text={copy.osage.word.gloss} /></span>
    </div>
    <div class="osage-text">
      <h2><T text={copy.osage.heading} /></h2>
      <p><T text={copy.osage.body} /></p>
      <a class="text-link" href={links.translator} target="_blank" rel="noopener">{copy.osage.translatorLabel} ↗</a>
    </div>
  </section>

  <section class="wrap block">
    <h2><T text={copy.beyond.heading} /></h2>
    <p class="measure"><T text={copy.beyond.body} /></p>
  </section>

  <section id="contact" class="contact">
    <div class="wrap contact-inner">
      <div>
        <h2><T text={copy.contact.heading} /></h2>
        <p><T text={copy.contact.body} /></p>
        <a class="btn btn-primary" href={links.mailto}>{copy.contact.button}</a>
      </div>
      <ul class="team">
        {team.map((m) => (
          <li><a href={m.url} target="_blank" rel="noopener">{m.name}</a><span>{m.title}</span></li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; overflow: hidden; color: #E3EDE5;
    background: radial-gradient(120% 90% at 50% 0%, #1F5A3F 0%, #0F3D2E 55%, #0A2C21 100%);
    --m-ink: #E3EDE5; --m-glass: #6F9C80; --m-leaf: #8CC79B; --m-bg: #0F3D2E; }
  .hero-inner { position: relative; padding-block: clamp(56px, 10vw, 112px) clamp(64px, 11vw, 128px);
    display: grid; justify-items: center; text-align: center; gap: 14px; }
  .hero h1 { font-size: var(--step-4); line-height: 1; margin: 6px 0 0; }
  .one-liner { font: 500 var(--step-1)/1.35 var(--body); margin: 0; max-width: 34ch; }
  .framing { font: 400 italic var(--step-1)/1.45 var(--display); color: #BFD6C6; margin: 0; max-width: 46ch; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 18px; }

  .block { padding-block: clamp(48px, 8vw, 88px) 0; }
  .block h2 { font-size: var(--step-3); line-height: 1.1; margin: 0 0 24px; }
  .panes { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
  .measure { max-width: 65ch; color: var(--muted); margin: 0; }

  .osage { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: clamp(24px, 5vw, 64px); align-items: center; }
  .word { display: grid; gap: 6px; padding: 28px; border-radius: var(--radius); background: var(--pane); border: 1px solid var(--pane-border); text-align: center; }
  .script { font: 400 clamp(2rem, 6vw, 3.2rem)/1.2 var(--osage); color: var(--fg); overflow-wrap: anywhere; }
  .latin { font: 500 1.15rem var(--body); }
  .gloss { color: var(--muted); font-style: italic; }
  .osage-text p { color: var(--muted); max-width: 60ch; }
  .text-link { font-weight: 600; }
  @media (max-width: 760px) { .osage { grid-template-columns: 1fr; } }

  .contact { margin-top: clamp(56px, 9vw, 96px); background: var(--mist); color: #14261E; }
  @media (prefers-color-scheme: dark) { .contact { background: #10241B; color: var(--fg); } }
  .contact-inner { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 40px; padding-block: 56px; align-items: start; }
  .contact h2 { font-size: var(--step-3); margin: 0 0 12px; }
  .contact p { margin: 0 0 20px; }
  .team { list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; }
  .team li { display: grid; gap: 2px; }
  .team a { font: 600 1.15rem var(--display); }
  .team span { color: var(--muted); font-size: .92rem; }
  @media (max-width: 760px) { .contact-inner { grid-template-columns: 1fr; } }
</style>
